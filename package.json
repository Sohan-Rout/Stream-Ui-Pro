{
  "name": "stream-ui-lib",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run ui:build && next dev",
    "build": "bun run ui:build && next build",
    "start": "next start",
    "lint": "eslint",
    "ui:build": "bun run --cwd packages/react build",
    "ui:dev": "bun run --cwd packages/react dev"
  },
  "dependencies": {
    "@streamui/react": "workspace:*",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "workspaces": [
    "packages/*"
  ]
}
