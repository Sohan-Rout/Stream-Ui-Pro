{
  "name": "stream-ui-lib",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run ui:build && next dev",
    "build": "bun run ui:build && next build",
    "start": "next start",
    "lint": "eslint",
    "ui:build": "bun run --cwd packages/react build",
    "ui:dev": "bun run --cwd packages/react dev",
    "test": "bun run ui:build && bun test",
    "typecheck": "next typegen && tsc --noEmit && bun run --cwd packages/react typecheck",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@streamuilib/react": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "workspaces": [
    "packages/*"
  ]
}
