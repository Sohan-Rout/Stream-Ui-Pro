{
  "name": "@streamuilib/react",
  "version": "0.4.0",
  "description": "Neobrutalism UI components for React and Tailwind CSS v4: hard edges, offset shadows, every state styled, plus animated icons.",
  "license": "MIT",
  "author": "Sohan Rout",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sohan-Rout/Stream-Ui-Pro.git",
    "directory": "packages/react"
  },
  "homepage": "https://streamui.org",
  "bugs": {
    "url": "https://github.com/Sohan-Rout/Stream-Ui-Pro/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://streamui.org/sponsor"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": {
      "style": "./dist/theme.css",
      "default": "./dist/theme.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "NODE_ENV=production bun run build.ts",
    "dev": "NODE_ENV=production bun run build.ts --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun test",
    "test": "bun test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "react-components",
    "tailwindcss",
    "tailwind-v4",
    "ui",
    "ui-library",
    "component-library",
    "neo-brutalism",
    "neobrutalism",
    "brutalism",
    "animated-icons",
    "nextjs",
    "typescript",
    "accessible",
    "neubrutalism",
    "brutalist-ui",
    "neobrutalism-ui",
    "tailwind-components",
    "react-animated-icons",
    "animated-svg-icons"
  ]
}
