# Copy to .env.local for local development, and set the same variables in
# your host (Vercel: Project Settings → Environment Variables).
# .env* files are gitignored; only this example is committed.
# Every variable is optional.

# Canonical site origin, used for canonical links, the sitemap, and share
# images. Defaults to https://streamui.org. Set it on preview deploys or forks.
NEXT_PUBLIC_SITE_URL=

# Crowdfunding links shown on /sponsor. Leave any of them empty to hide that
# platform. Each must be a full https URL.
FUNDING_RAZORPAY_URL=          # e.g. https://razorpay.me/@yourname
FUNDING_OPEN_COLLECTIVE_URL=   # e.g. https://opencollective.com/streamui
FUNDING_KOFI_URL=              # e.g. https://ko-fi.com/yourname
